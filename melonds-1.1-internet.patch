-void GPU3D::Write32(u32 addr, u32 val) noexcept
-{
-    if (!RenderingEnabled && addr >= 0x04000320 && addr < 0x04000400) return;
-    if (!GeometryEnabled  && addr >= 0x04000400 && addr < 0x04000700) return;
-
-    switch (addr)
-    {
-    case 0x04000060:
-        DispCnt = (val & 0x4FFF) | (DispCnt & 0x3000);
