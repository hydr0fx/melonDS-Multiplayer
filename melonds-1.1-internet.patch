-        // checkme (Z<0 shouldn't be possible, but Z>0xFFFFFF is possible)
-        if (z < 0) z = 0;
-        else if (z > 0xFFFFFF) z = 0xFFFFFF;
-
-        poly->FinalZ[i] = z;
-        poly->FinalW[i] = w;
-    }
-
-    if (PolygonMode >= 2)
-        LastStripPolygon = poly;
-    else
-        LastStripPolygon = NULL;
-}
