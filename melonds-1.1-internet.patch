+void SPU::SetSampleRate(AudioSampleRate rate)
+{
+    if (rate == AudioSampleRate::_47KHz)
+    {
+        MixInterval = 704;
+    }
+    else
+    {
+        MixInterval = 1024;
+    }
+
+    memset(OutputLastSamples, 0, sizeof(OutputLastSamples));
+}
