-template<bool window>
-void SoftRenderer::DrawSprite_Normal(u32 num, u32 width, u32 height, s32 xpos, s32 ypos)
-{
-    u16* oam = (u16*)&GPU.OAM[CurUnit->Num ? 0x400 : 0];
