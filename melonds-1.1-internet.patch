-void SPU::Stop()
-{
-    Platform::Mutex_Lock(AudioLock);
-    memset(OutputBuffer, 0, 2*OutputBufferSize*2);
-
-    blip_clear(BlipLeft);
-    blip_clear(BlipRight);
-    BlipTimer = 0;
-
-    OutputBufferReadPos = 0;
-    OutputBufferWritePos = 0;
-    Platform::Mutex_Unlock(AudioLock);
-}
