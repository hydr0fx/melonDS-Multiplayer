+void Log(LogLevel level, const char* fmt, ...)
+{
+    if (fmt == nullptr)
+        return;
+
+    va_list args;
+    va_start(args, fmt);
+    if (NetSync::Active() && (level == LogLevel::Warn || level == LogLevel::Error))
+    {
+        if (strncmp(fmt, "wifi", 4) == 0 || strncmp(fmt, "WIFI", 4) == 0 ||
+            strncmp(fmt, "DeterministicMP", 15) == 0 || strncmp(fmt, "bad frame", 9) == 0)
+        {
+            va_list argsNet;
+            va_copy(argsNet, args);
+            char buf[512];
+            vsnprintf(buf, sizeof(buf), fmt, argsNet);
+            va_end(argsNet);
+            NetSync::Log("[CORE %s] %s", level == LogLevel::Error ? "ERR" : "WARN", buf);
+        }
+    }
+#ifdef LAN_DEBUG
+    va_list args2;
+    va_copy(args2, args);
+#endif
+    vprintf(fmt, args);
+    va_end(args);
+#ifdef LAN_DEBUG
+    fflush(stdout);
+    static FILE* lanlog = fopen("lanlog.txt", "w");
+    if (lanlog)
+    {
+        vfprintf(lanlog, fmt, args2);
+        fflush(lanlog);
+    }
+    va_end(args2);
+#endif
+}
