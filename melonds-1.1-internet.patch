-
-    u32 pixelattr = ((attrib[2] & 0x0C00) << 6) | 0xC0000;
-    u32 tilenum = attrib[2] & 0x03FF;
-    u32 spritemode = window ? 0 : ((attrib[0] >> 10) & 0x3);
-
-    u32 wmask = width - 8; // really ((width - 1) & ~0x7)
-
-    if ((attrib[0] & 0x1000) && !window)
