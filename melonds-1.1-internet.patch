-    u16 color = 0; // transparent in all cases
-
-    if (spritemode == 3)
-    {
-        // bitmap sprite
-
-        u32 alpha = attrib[2] >> 12;
-        if (!alpha) return;
-        alpha++;
-
-        pixelattr |= (0xC0000000 | (alpha << 24));
-
-        u32 pixelsaddr = tilenum;
-        if (CurUnit->DispCnt & 0x40)
-        {
-            if (CurUnit->DispCnt & 0x20)
-            {
-                // 'reserved'
