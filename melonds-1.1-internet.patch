+int main(int argc, char** argv)
+{
+    sysTimer.start();
+    srand(time(nullptr));
+
+    for (int i = 0; i < kMaxEmuInstances; i++)
+        emuInstances[i] = nullptr;
+
+    qputenv("QT_SCALE_FACTOR", "1");
+
+#if QT_VERSION_MAJOR == 6 && defined(__WIN32__)
+    // Allow using the system dark theme palette on Windows
+    qputenv("QT_QPA_PLATFORM", "windows:darkmode=2");
+#endif
+
+    printf("melonDS " MELONDS_VERSION "\n");
+    printf(MELONDS_URL "\n");
+
+    // easter egg - not worth checking other cases for something so dumb
+    if (argc != 0 && (!strcasecmp(argv[0], "derpDS") || !strcasecmp(argv[0], "./derpDS")))
+        printf("did you just call me a derp???\n");
+
+    MelonApplication melon(argc, argv);
+#ifdef __APPLE__
+    // Prevent macOS App Nap / timer coalescing when tabbed out or unfocused
+    {
+        id procInfo = ((id(*)(Class, SEL))objc_msgSend)(objc_getClass("NSProcessInfo"), sel_registerName("processInfo"));
+        id reason = ((id(*)(Class, SEL, const char*))objc_msgSend)(objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "melonDS real-time emulation and netplay");
+        // NSActivityUserInitiatedAllowingIdleSystemSleep (0x00EFFFFFULL) | NSActivityLatencyCritical (0xFF00000000ULL)
+        ((id(*)(id, SEL, unsigned long long, id))objc_msgSend)(
+            procInfo, sel_registerName("beginActivityWithOptions:reason:"), 0xFF00EFFFFFULL, reason);
+    }
+#endif
+    pathInit();
+
+    CLI::CommandLineOptions* options = CLI::ManageArgs(melon);
+
+    // http://stackoverflow.com/questions/14543333/joystick-wont-work-using-sdl
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+
+    SDL_SetHint(SDL_HINT_APP_NAME, "melonDS");
+
+    if (SDL_Init(SDL_INIT_HAPTIC) < 0)
+    {
+        printf("SDL couldn't init rumble\n");
+    }
+    if (SDL_Init(SDL_INIT_JOYSTICK) < 0)
+    {
+        printf("SDL couldn't init joystick\n");
+    }
+    if (SDL_Init(SDL_INIT_SENSOR) < 0)
+    {
+        printf("SDL couldn't init motion sensors\n");
+    }
+    if (SDL_Init(SDL_INIT_AUDIO) < 0)
+    {
+        const char* err = SDL_GetError();
+        QString errorStr = "Failed to initialize SDL. This could indicate an issue with your audio driver.\n\nThe error was: ";
+        errorStr += err;
+
+        QMessageBox::critical(nullptr, "melonDS", errorStr);
+        return 1;
+    }
+
+    SDL_JoystickEventState(SDL_ENABLE);
+
+    SDL_InitSubSystem(SDL_INIT_VIDEO);
+    SDL_EnableScreenSaver(); SDL_DisableScreenSaver();
+
+    if (!Config::Load())
+        QMessageBox::critical(nullptr,
+                              "melonDS",
+                              "Unable to write to config.\nPlease check the write permissions of the folder you placed melonDS in.");
+
+    camStarted[0] = false;
+    camStarted[1] = false;
+    camManager[0] = new CameraManager(0, 640, 480, true);
+    camManager[1] = new CameraManager(1, 640, 480, true);
+
+    systemThemeName = new QString(QApplication::style()->objectName());
+
+    {
+        Config::Table cfg = Config::GetGlobalTable();
+        QString uitheme = cfg.GetQString("UITheme");
+        if (!uitheme.isEmpty())
+        {
+            QApplication::setStyle(uitheme);
+        }
+    }
+
+    // fix for Wayland OpenGL glitches
+    QGuiApplication::setAttribute(Qt::AA_NativeWindows, false);
+    QGuiApplication::setAttribute(Qt::AA_DontCreateNativeWidgetSiblings, true);
+
+    // default MP interface type is local MP
+    // this will be changed if a LAN or netplay session is initiated
+    setMPInterface(MPInterface_Local);
+
+    NetInit();
+
+    NetSync::ApplyCLIOptions(*options);
+
+    if (NetSync::Configured() || (getenv("MELONDS_NETSYNC") && *getenv("MELONDS_NETSYNC")))
+    {
+        // ---------------- NetSync session ----------------
+        QString rompath = options->dsRomPath.has_value() ? *options->dsRomPath : QString();
+        std::string err;
+
+        // settings that must be identical on every PC
+        {
+            Config::Table g = Config::GetGlobalTable();
+            QString appDir = QCoreApplication::applicationDirPath();
+            auto resolveSidecar = [&](const char* key, const char* filename)
+            {
+                QStringList candidates = {
+                    appDir + QDir::separator() + filename,
+                    appDir + "/BIOS_and_ROMs/" + filename,
+                    appDir + "/../" + filename,
+                    appDir + "/../BIOS_and_ROMs/" + filename,
+                };
+#ifdef __APPLE__
+                candidates << (appDir + "/../../../" + filename)
+                           << (appDir + "/../../../BIOS_and_ROMs/" + filename);
+#endif
+                for (const QString& c : candidates)
+                {
+                    if (QFile::exists(c))
+                    {
+                        g.SetString(key, QFileInfo(c).canonicalFilePath().toStdString());
+                        return;
+                    }
+                }
+            };
+            resolveSidecar("DS.BIOS7Path", "bios7.bin");
+            resolveSidecar("DS.BIOS9Path", "bios9.bin");
+            resolveSidecar("DS.FirmwarePath", "firmware.bin");
+            g.SetBool("Emu.DirectBoot", true);
+            g.SetBool("Emu.ExternalBIOSEnable", true);
+            g.SetInt("Emu.ConsoleType", 0);
+            g.SetInt("Mic.InputType", 2);
+            g.SetInt("MP.RecvTimeout", 10000);
+            g.SetInt("MP.AudioMode", 0);
+            g.SetInt("Audio.Interpolation", 1);
+            g.SetInt("Audio.BitDepth", 2);
+            g.SetInt("3D.Renderer", 0);
+            g.SetBool("3D.Soft.Threaded", true);
+            g.SetBool("AudioSync", false);
+            g.SetBool("LimitFPS", true);
+            g.SetBool("PauseLostFocus", false);
+        }
+
+        if (rompath.isEmpty() || !NetSync::Start(rompath.toStdString(), err))
+        {
+            if (rompath.isEmpty()) err = "No ROM selected.";
+            QMessageBox::critical(nullptr, "Multiplayer", QString::fromStdString(err));
+            NetSync::Stop();
+            SDL_Quit();
+            return 1;
+        }
+
+        {
+            Config::Table g = Config::GetGlobalTable();
+            g.SetBool("JIT.Enable", NetSync::UseJIT());
+            g.SetInt("JIT.MaxBlockSize", 32);
+            g.SetBool("JIT.LiteralOptimisations", true);
+            g.SetBool("JIT.BranchOptimisations", true);
+#ifdef __APPLE__
+            g.SetBool("JIT.FastMemory", false);
+#else
+            g.SetBool("JIT.FastMemory", true);
+#endif
+        }
+        setMPInterface(MPInterface_Deterministic);
+
+        int nplayers = NetSync::NumPlayers();
+        int myslot = NetSync::LocalSlot();
+        for (int i = 0; i < nplayers; i++)
+            createEmuInstance();
+
+        for (int i = 0; i < nplayers; i++)
+        {
+            EmuInstance* inst = emuInstances[i];
+            QString e;
+            bool ok;
+            if (i == 0)
+                ok = inst->getEmuThread()->bootROM(QStringList{rompath}, e);
+            else
+                ok = inst->getEmuThread()->bootFirmware(e);
+
+            if (!ok)
+            {
+                QMessageBox::critical(nullptr, "Multiplayer", QString("Failed to start instance %1: %2").arg(i + 1).arg(e));
+                NetSync::Stop();
+                deleteAllEmuInstances();
+                SDL_Quit();
+                return 1;
+            }
+        }
+
+        // every PC starts the host DS with the host's save data (or blank SRAM if host has none)
+        const auto& hostsave = NetSync::HostSave();
+        if (!hostsave.empty() && emuInstances[0]->getNDS())
+            emuInstances[0]->getNDS()->SetNDSSave(hostsave.data(), (u32)hostsave.size());
+
+        // only show the DS this PC controls; hidden instances skip pixel rasterization and host audio resampling
+        for (int i = 0; i < nplayers; i++)
+        {
+            if (NDS* nds = emuInstances[i]->getNDS())
+            {
+                nds->GPU.SetSkipRender(i != myslot);
+                nds->SPU.SetSkipOutput(i != myslot);
+            }
+
+            MainWindow* w = emuInstances[i]->getMainWindow();
+            if (w) w->hide();
+        }
+
+        if (!NetSync::WaitAndGo(err))
+        {
+            NetSync::FinishLoading();
+            QMessageBox::critical(nullptr, "Multiplayer", QString::fromStdString(err));
+            NetSync::Stop();
+            deleteAllEmuInstances();
+            SDL_Quit();
+            return 1;
+        }
+
+        NetSync::FinishLoading();
+        if (!getenv("MELONDS_NETSYNC_HEADLESS") && emuInstances[myslot])
+        {
+            if (MainWindow* w = emuInstances[myslot]->getMainWindow())
+            {
+                w->show();
+                w->raise();
+                w->activateWindow();
+            }
+        }
