-void GPU3D::VecTest(u32 param) noexcept
-{
-    // TODO: maybe it overwrites the normal registers, too
-
-    s16 normal[3];
-
-    normal[0] = (s16)((param & 0x000003FF) << 6) >> 6;
-    normal[1] = (s16)((param & 0x000FFC00) >> 4) >> 6;
