-void Wifi::ScheduleTimer(bool first)
-{
-    if (first) TimerError = 0;
-
-    s32 cycles = 33513982 * kTimerInterval;
-    cycles -= TimerError;
-    s32 delay = (cycles + 999999) / 1000000;
-    TimerError = (delay * 1000000) - cycles;
-
-    NDS.ScheduleEvent(Event_Wifi, !first, delay, 0, 0);
-}
