-void NDS::RegisterEventFuncs(u32 id, void* that, const std::initializer_list<EventFunc>& funcs)
-{
-    SchedEvent& evt = SchedList[id];
-
-    evt.That = that;
-    assert(funcs.size() <= MaxEventFunctions);
-    int i = 0;
-    for (EventFunc func : funcs)
-    {
-        evt.Funcs[i++] = func;        
