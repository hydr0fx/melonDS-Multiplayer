+void EmuInstance::inputLoadConfig()
+{
+    SDL_LockMutex(joyMutex.get());
+
+    // NetSync: every PC controls one instance with its normal (instance 0) key mapping
+    Config::Table inputCfg = NetSync::Configured() ? Config::GetLocalTable(0) : localCfg;
+    Config::Table keycfg = inputCfg.GetTable("Keyboard");
+    Config::Table joycfg = inputCfg.GetTable("Joystick");
+
+    for (int i = 0; i < 12; i++)
+    {
+        keyMapping[i] = keycfg.GetInt(buttonNames[i]);
+        joyMapping[i] = joycfg.GetInt(buttonNames[i]);
+    }
+
+    for (int i = 0; i < HK_MAX; i++)
+    {
+        hkKeyMapping[i] = keycfg.GetInt(hotkeyNames[i]);
+        hkJoyMapping[i] = joycfg.GetInt(hotkeyNames[i]);
+    }
+
+    setJoystick(inputCfg.GetInt("JoystickID"));
+    SDL_UnlockMutex(joyMutex.get());
+}
