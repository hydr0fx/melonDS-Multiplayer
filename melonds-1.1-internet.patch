+Table::Table(toml::value& data, const std::string& path) : Data(data)
+{
+    if (path.empty())
+        PathPrefix = "";
+    else
+        PathPrefix = path + ".";
+}
+
+Table& Table::operator=(const Table& b)
+{
+    Data = b.Data;
+    PathPrefix = b.PathPrefix;
+
