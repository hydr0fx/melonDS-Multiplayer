-        if (!sequence[i])
-            break;
-
-        romIcon(data[SEQ_BMP(sequence[i])], palette[SEQ_PAL(sequence[i])], animatedIconRef[i]);
-        u32* frame = animatedIconRef[i];
-
-        if (SEQ_FLIPH(sequence[i]))
-        {
-            for (int x = 0; x < 32; x++)
-            {
-                for (int y = 0; y < 32/2; y++)
-                {
-                    std::swap(frame[x * 32 + y], frame[x * 32 + (32 - 1 - y)]);
