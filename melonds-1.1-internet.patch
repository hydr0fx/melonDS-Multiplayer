+// generate interpolation tables
+// values are 1:1:14 fixed-point
+constexpr std::array<s16, 0x100> InterpCos = []() constexpr {
+    std::array<s16, 0x100> interp {};
+
+    for (int i = 0; i < 0x100; i++)
+    {
