-void GPU::SetDispStat(u32 cpu, u16 val) noexcept
-{
-    val &= 0xFFB8;
-    DispStat[cpu] &= 0x0047;
-    DispStat[cpu] |= val;
-
-    VMatch[cpu] = (val >> 8) | ((val & 0x80) << 1);
