-        // * other registers like GPIO_WIFI may also control wifi power/clock
-        // * turning wifi off via POWCNT2 while sending breaks further attempts at sending frames
-    }
-    else
-    {
-        on = on && ((IOPORT(W_PowerUS) & 0x1) == 0);
