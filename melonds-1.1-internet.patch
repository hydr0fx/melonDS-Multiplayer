+int EmuThread::bootFirmware(QString& errorstr)
+{
+    sendMessage(msg_BootFirmware);
+    waitMessage();
+    if (!msgResult)
+    {
+        errorstr = msgError;
+        return msgResult;
+    }
+
+    sendMessage(msg_EmuRun);
+    waitMessage();
+    errorstr = "";
+    return msgResult;
+}
