+bool NDS::RunSlice(u64 targetSysTimestamp)
+{
+#ifdef JIT_ENABLED
+    if (EnableJIT)
+        return RunSlice<CPUExecuteMode::JIT>(targetSysTimestamp);
+    else
+#endif
+#ifdef GDBSTUB_ENABLED
+    if (EnableGDBStub)
+    {
+        return RunSlice<CPUExecuteMode::InterpreterGDB>(targetSysTimestamp);
+    } else
+#endif
+    {
+        return RunSlice<CPUExecuteMode::Interpreter>(targetSysTimestamp);
+    }
+}
