-
-            u8 val;
-            if (vramaddr >= 0x20000 && vramaddr < 0x40000) // reading slot 1 for texels should always read 0
-                val = 0;
-            else
-            {
-                val = gpu.ReadVRAMFlat_Texture<u8>(vramaddr);
