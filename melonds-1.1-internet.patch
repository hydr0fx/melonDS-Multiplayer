+
+void Semaphore_Reset(Semaphore* sema)
+{
+    QSemaphore* s = (QSemaphore*) sema;
+
+    s->acquire(s->available());
+}
+
+void Semaphore_Wait(Semaphore* sema)
+{
+    ((QSemaphore*) sema)->acquire();
+}
