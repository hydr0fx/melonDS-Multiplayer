-template <typename T>
-constexpr T ipow(T num, unsigned int pow)
-{
-    T product = 1;
-    for (int i = 0; i < pow; ++i)
-    {
-        product *= num;
-    }
-
-    return product;
-}
-
-template <typename T>
-constexpr T factorial(T num)
-{
-    T product = 1;
-    for (T i = 1; i <= num; ++i)
-    {
-        product *= i;
-    }
-
-    return product;
-}
