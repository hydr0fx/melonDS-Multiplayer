-            }
-            else if (!window)
-            {
-                if (objLine[xpos] == 0)
-                    objLine[xpos] = pixelattr & 0x180000;
-            }
-
-            xoff++;
-            xpos++;
-        }
-    }
-    else
-    {
-        u32 pixelsaddr = tilenum;
