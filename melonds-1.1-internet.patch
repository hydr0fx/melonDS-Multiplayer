+        {
+            if (strcmp(od, "host") == 0)
+                QTimer::singleShot(350, win, [win]() { QMetaObject::invokeMethod(win, "onNPStartHost"); });
+            else if (strcmp(od, "join") == 0)
+                QTimer::singleShot(350, win, [win]() { QMetaObject::invokeMethod(win, "onNPStartClient"); });
+        }
+    }
+
+    int ret = melon.exec();
+
+    delete options;
+
+    // if we get here, all the existing emu instances should have been deleted already
+    // but with this we make extra sure they are all deleted
+    deleteAllEmuInstances();
+
+    delete camManager[0];
+    delete camManager[1];
+
+    Config::Save();
+
+    SDL_Quit();
+    return ret;
+}
