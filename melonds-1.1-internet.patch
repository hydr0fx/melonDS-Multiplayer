-void NDS::Reschedule(u64 target)
-{
-    if (CurCPU == 0)
-    {
-        if (target < (ARM9Target >> ARM9ClockShift))
-            ARM9Target = (target << ARM9ClockShift);
-    }
-    else
-    {
-        if (target < ARM7Target)
-            ARM7Target = target;
-    }
-}
