+static QString netplayBaseDir()
+{
+    QString appDir = QCoreApplication::applicationDirPath();
+#ifdef __APPLE__
+    QDir d(appDir);
+    if (d.cd("..") && d.cd("..") && d.dirName().endsWith(".app") && d.cd(".."))
+        return d.absolutePath();
+#elif defined(_WIN32)
+    QDir d(appDir);
+    if (d.dirName().compare("bin", Qt::CaseInsensitive) == 0 && d.cd(".."))
+        return d.absolutePath();
+#endif
+    return appDir;
