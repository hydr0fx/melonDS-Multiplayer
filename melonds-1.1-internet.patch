-void SPU::Reset()
-{
-    InitOutput();
-
-    Cnt = 0;
-    MasterVolume = 0;
-    Bias = 0;
-    Mute = false;
-
-    for (int i = 0; i < 16; i++)
-        Channels[i].Reset();
