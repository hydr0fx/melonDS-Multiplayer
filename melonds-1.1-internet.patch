+    NDS(
+        NDSArgs {
+            std::make_unique<ARM9BIOSImage>(bios_arm9_bin),
+            std::make_unique<ARM7BIOSImage>(bios_arm7_bin),
+            Firmware(0),
+        }
+    )
+{
+}
