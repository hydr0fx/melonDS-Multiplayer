+                    DrawBG_3D();
+                else
+                    DoDrawBG(Text, line, 0);
+            }
+        }
+        if ((dispCnt & 0x1000) && NumSprites[CurUnit->Num])
+        {
+            DoInterleaveSprites(0x40000 | (i<<16))
+        }
+    }
+}
