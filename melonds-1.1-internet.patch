+
+u32* GPU3D::GetLine(int line) noexcept
+{
+    if (!AbortFrame)
+    {
+        u32* rawline = CurrentRenderer->GetLine(line);
+
+        if (RenderXPos == 0) return rawline;
+
+        // apply X scroll
+
+        if (RenderXPos & 0x100)
+        {
+            int i = 0, j = RenderXPos;
+            for (; j < 512; i++, j++)
+                ScrolledLine[i] = 0;
+            for (j = 0; i < 256; i++, j++)
+                ScrolledLine[i] = rawline[j];
+        }
+        else
+        {
+            int i = 0, j = RenderXPos;
+            for (; j < 256; i++, j++)
+                ScrolledLine[i] = rawline[j];
+            for (; i < 256; i++)
+                ScrolledLine[i] = 0;
+        }
+    }
+    else
+    {
+        memset(ScrolledLine, 0, 256*4);
+    }
+
+    return ScrolledLine;
+}
