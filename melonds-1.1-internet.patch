-    {
-        bool zerodot = true;
-        bool allbehind = true;
-
-        for (int i = 0; i < nverts; i++)
-        {
-            Vertex* vtx = &clippedvertices[i];
-
-            if (vtx->FinalPosition[0] != clippedvertices[0].FinalPosition[0] ||
-                vtx->FinalPosition[1] != clippedvertices[0].FinalPosition[1])
-            {
-                zerodot = false;
-                break;
-            }
-
-            if (vtx->Position[3] <= ZeroDotWLimit)
