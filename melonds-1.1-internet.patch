-constexpr array2d<s16, 0x100, 4> InterpCubic = []() constexpr {
-    array2d<s16, 0x100, 4> interp {};
-
-    for (int i = 0; i < 0x100; i++)
-    {
-        s32 i1 = i << 6;
-        s32 i2 = (i * i) >> 2;
-        s32 i3 = (i * i * i) >> 10;
-
-        interp[i][0] = -i3 + 2*i2 - i1;
-        interp[i][1] = i3 - 2*i2 + 0x4000;
-        interp[i][2] = -i3 + i2 + i1;
-        interp[i][3] = i3 - i2;
-    }
-
-    return interp;
-}();
