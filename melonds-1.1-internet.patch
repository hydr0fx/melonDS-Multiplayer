+int EmuThread::bootROM(const QStringList& filename, QString& errorstr)
+{
+    sendMessage({.type = msg_BootROM, .param = filename});
+    waitMessage();
+    if (!msgResult)
+    {
+        errorstr = msgError;
+        return msgResult;
+    }
+
+    sendMessage(msg_EmuRun);
+    waitMessage();
+    errorstr = "";
+    return msgResult;
+}
