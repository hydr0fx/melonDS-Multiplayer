-            }
-        }
-        else
-        {
-            if (CurUnit->DispCnt & 0x20)
-            {
-                pixelsaddr = ((tilenum & 0x01F) << 4) + ((tilenum & 0x3E0) << 7);
-                pixelsaddr += (ypos * 256 * 2);
